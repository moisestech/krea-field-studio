# Replay works with no secrets.
# Copy to .env (gitignored). Never commit .env.
# Never paste KREA_API_KEY into chat, issues, or screenshots.
# Live recording is a local operator command, not a public form.
KREA_API_KEY=
KREA_WEBHOOK_URL=
KREA_LIVE_ACK=
DATABASE_URL=postgres://field:field@localhost:5432/field_studio
PUBLIC_APP_URL=http://localhost:5173
